generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  DRAFT
  COMPLETED
}

enum ActionItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  meetings     Meeting[]

  @@map("users")
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  title       String        @db.VarChar(200)
  description String?       @db.Text
  meetingDate DateTime?     @map("meeting_date")
  attendees   String[]      @default([])
  rawNotes    String?       @map("raw_notes") @db.Text
  summary     String?       @db.Text
  decisions   Json?
  status      MeetingStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes       MeetingNote[]
  actionItems ActionItem[]

  @@index([ownerId, updatedAt])
  @@map("meetings")
}

model MeetingNote {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @map("meeting_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("meeting_notes")
}

model ActionItem {
  id          String           @id @default(uuid()) @db.Uuid
  meetingId   String           @map("meeting_id") @db.Uuid
  title       String           @db.VarChar(300)
  description String?          @db.Text
  assignee    String?          @db.VarChar(150)
  dueDate     DateTime?        @map("due_date")
  status      ActionItemStatus @default(TODO)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  meeting     Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@map("action_items")
}
